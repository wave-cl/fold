//! The orders example, application layer: the commands, the rules they must
//! respect and the process that ties the contexts together. What an
//! application node knows.

layer application

import "derive.fold"

commands Customers.Customer {
  Register { name: string } -> wasm "orders.wasm" export "handle_register"
}

commands Shipping.Shipment {
  Prepare { order_id: uuid, customer_id: uuid } -> wasm "orders.wasm" export "handle_prepare_shipment",
  Ship {}                                        -> wasm "orders.wasm" export "handle_ship",
  Cancel {}                                      -> wasm "orders.wasm" export "handle_cancel_shipment"
}

commands Orders.Order {
  PlaceOrder  { customer_id: uuid, lines: [Line] } -> wasm "orders.wasm" export "handle_place_order",
  AddLine     { line: Line }                       -> wasm "orders.wasm" export "handle_add_line",
  RemoveLine  { line_id: uuid }                    -> wasm "orders.wasm" export "handle_remove_line",
  CancelOrder { reason: string? }                  -> wasm "orders.wasm" export "handle_cancel_order"
}

// checked against the state every command would leave behind
invariants Orders.Order {
  LinesNotEmpty -> wasm "orders.wasm" export "check_lines_not_empty"
}

/// A process manager: when an order is placed, have a shipment prepared;
/// when it is cancelled, cancel the shipment; remember what the shipment
/// did, and note when a cancellation came too late. An order placed with
/// `overdue_after_ms` in its metadata is cancelled by the ShipmentOverdue
/// timer unless it ships first.
process Orders.Fulfilment {
  key order_id: uuid
  from OrderPlaced, OrderCancelled, Shipping.ShipmentPrepared, Shipping.ShipmentShipped, Shipping.ShipmentCancelled
  state { customer_id: uuid, shipment: string, cancel_refused: bool }
  react wasm "orders.wasm" export "react_fulfilment"
  timers ShipmentOverdue
}

// a rule across the context: at most five open orders per customer, read
// from the CustomerOrders projection and serialized per customer
invariant Orders.MaxOpenOrders {
  on Order
  projection CustomerOrders
  scope customer_id
  check wasm "orders.wasm" export "check_max_open_orders"
}
